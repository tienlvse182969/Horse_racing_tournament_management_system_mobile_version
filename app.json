{
  "expo": {
    "name": "RacetrackVN",
    "slug": "horse_racing_tournament_management_system_mobile_version",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/RacetrackVN_logo.png",
    "scheme": "horseracingtournamentmanagementsystemmobileversion",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/RacetrackVN_logo.png",
      "infoPlist": {
        "NSCalendarsUsageDescription": "Ứng dụng cần quyền truy cập lịch để thêm sự kiện đua ngựa.",
        "NSCalendarsFullAccessUsageDescription": "Ứng dụng cần quyền truy cập lịch để thêm sự kiện đua ngựa."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#170A0A",
        "foregroundImage": "./assets/images/RacetrackVN_logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.horse_racing_tournament_management_system_mobile_version",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "newArchEnabled": false,
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-calendar",
        {
          "calendarPermission": "Ứng dụng cần quyền truy cập lịch để thêm sự kiện đua ngựa."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#170A0A",
          "image": "./assets/images/RacetrackVN_logo.png",
          "imageWidth": 200
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a9b28041-fea6-4468-99a4-34f5937f5cb9"
      }
    },
    "owner": "maykhoi614"
  }
}

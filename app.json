{
  "expo": {
    "name": "horse_racing_tournament_management_system_mobile_version",
    "slug": "horse_racing_tournament_management_system_mobile_version",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "horseracingtournamentmanagementsystemmobileversion",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSCalendarsUsageDescription": "Ứng dụng cần quyền truy cập lịch để thêm sự kiện đua ngựa.",
        "NSCalendarsFullAccessUsageDescription": "Ứng dụng cần quyền truy cập lịch để thêm sự kiện đua ngựa."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.horse_racing_tournament_management_system_mobile_version",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "newArchEnabled": false,
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-calendar",
        {
          "calendarPermission": "Ứng dụng cần quyền truy cập lịch để thêm sự kiện đua ngựa."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
